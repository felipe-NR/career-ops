{
  "description": "Show career-ops startup checks and the cost-benefit funnel on the first Codex turn.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/career-ops-startup.mjs\"",
            "commandWindows": "for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do node \"%R\\.codex\\hooks\\career-ops-startup.mjs\"",
            "timeout": 20,
            "statusMessage": "career-ops startup..."
          }
        ]
      }
    ]
  }
}
